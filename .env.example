# Copy to .env and set values.

# Mapbox public token (https://account.mapbox.com)
NEXT_PUBLIC_MAPBOX_TOKEN="your_mapbox_public_token_here"

# Auth0 configuration
AUTH0_SECRET="your_auth0_secret_here"
AUTH0_DOMAIN="your-tenant.auth0.com"
AUTH0_CLIENT_ID="your_auth0_client_id_here"
AUTH0_CLIENT_SECRET="your_auth0_client_secret_here"
APP_BASE_URL="http://localhost:3000"

# Sentry error monitoring (https://sentry.io/settings/<org>/projects/<project>/keys/)
NEXT_PUBLIC_SENTRY_DSN="your_sentry_dsn_here"

# Discord webhooks
DISCORD_WEBHOOK_URL=""
DISCORD_REGULAR_VISITS_WEBHOOK_URL=""
DISCORD_REFERRAL_VISITS_WEBHOOK_URL=""
DISCORD_BUG_REPORTS_WEBHOOK_URL=""
DISCORD_AI_VISITS_WEBHOOK_URL=""


# Langfuse LLM tracing (https://cloud.langfuse.com → Settings → API Keys)
# Real values belong in .env (gitignored), never here — this file is committed.
LANGFUSE_SECRET_KEY="sk-lf-your_secret_key_here"
LANGFUSE_PUBLIC_KEY="pk-lf-your_public_key_here"
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
# Opt in to sending traces from local dev (production always sends).
LANGFUSE_TRACING_DEV="false"